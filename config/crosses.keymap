#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&mt CAPSLOCK SQT            &kp COMMA  &kp PERIOD  &kp P          &kp Y        &kp F      &kp G                  &kp C        &kp R  &kp L
&kp A                       &kp O      &kp E       &kp U          &kp I        &kp D      &kp H                  &kp T        &kp N  &kp S
&mt LEFT_CONTROL SEMICOLON  &kp Q      &kp J       &kp K          &lt 3 X      &kp B      &kp M                  &kp W        &kp V  &kp Z
                                       &mkp MB1    &kp BACKSPACE  &lt 1 ESC    &lt 2 TAB  &mt RIGHT_SHIFT ENTER  &lt 4 SPACE
            >;
        };

        layer_1 {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT    &kp CARET  &kp AMPERSAND  &kp ASTERISK          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp LEFT_SHIFT   &mkp MB1     &mkp MB3  &mkp MB2    &mkp MB4       &kp GRAVE  &kp MINUS      &kp EQUAL             &kp LEFT_BRACE        &kp RIGHT_BRACE
&none            &none        &none     &none       &mkp MB5       &none      &kp SLASH      &kp NON_US_BACKSLASH  &kp LEFT_BRACKET      &kp RIGHT_BRACKET
                              &none     &none       &none          &mkp MB4   &mkp MB5       &mo 4
            >;
        };

        layer_2 {
            bindings = <
&none           &kp K_MUTE      &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_PLAY_PAUSE    &kp LOCKING_NUM  &kp N7        &kp N8        &kp N9        &kp MINUS
&kp LEFT        &kp DOWN        &kp UP_ARROW       &kp RIGHT        &kp PAGE_UP         &kp PLUS         &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp ASTERISK
&kp LEFT_SHIFT  &kp LEFT_ARROW  &kp DOWN_ARROW     &kp RIGHT_ARROW  &kp PAGE_DOWN       &kp N0           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH
                                &none              &kp K_LOCK       &kp K_POWER         &none            &none         &none
            >;
        };

        layer_3 {
            bindings = <
&mt F2 F1    &mt F4 F3  &mt F6 F5  &mt F8 F7  &mt F10 F9    &none       &none         &none         &none         &none
&mt F12 F11  &none      &none      &none      &none         &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3
&none        &none      &none      &none      &none         &none       &none         &none         &none         &none
                        &none      &none      &none         &none       &none         &none
            >;
        };

        layer_4 {
            bindings = <
&mt CAPSLOCK SQT            &kp COMMA  &kp PERIOD  &kp P               &kp Y             &kp F            &kp G                &kp C  &kp R  &kp L
&mt LEFT_SHIFT A            &kp O      &kp E       &mt LEFT_COMMAND U  &mt LEFT_ALT I    &mt RIGHT_ALT D  &mt RIGHT_COMMAND H  &kp T  &kp N  &mt RIGHT_SHIFT S
&mt LEFT_CONTROL SEMICOLON  &kp Q      &kp J       &kp K               &lt 3 X           &kp B            &kp M                &kp W  &kp V  &mt RIGHT_CONTROL Z
                                       &mkp MB1    &kp SPACE           &none             &none            &none                &none
            >;
        };

        /* layer_2 {
            bindings = <
&none  &none   &none    &none   &none         &none         &kp N1         &none         &none     &none  &none   &to 0
&none  &none   &none    &none   &none         &none         &none         &none          &rgb_ug RGB_BRD &rgb_ug RGB_BRI  &rgb_ug RGB_EFF   &rgb_ug RGB_TOG
&none  &none   &none    &none   &none         &none         &none         &mkp LCLK     &mkp RCLK  &none  &none   &none
&none  &none   &none    &none   &bt BT_NXT  &bt BT_CLR    &none         &none         &none     &none  &none   &none
                                   &none         &none         &none         &none         &none
                                                 &none         &none         &none
            >;
       
            
        };

       Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &trans        &trans        &mkp MCLK     &trans     &none         &none       &trans     &mkp MCLK     &trans        &trans        &none
&bootloader  &trans        &mkp RCLK     &mo 4         &mkp LCLK  &mo 5         &mo 5       &mkp LCLK  &mo 4         &mkp RCLK     &trans        &bootloader
                                         &mo 5         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &trans        &trans
            >;

            
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
               
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
        };*/
    };
};
